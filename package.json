{
    "name": "cafe",
    "version": "1.0.0",
    "private": true,
    "description": "Coffee beans and water ratio calculator for different brewing methods",
    "license": "GPL-3.0",
    "author": "Thiago Duarte",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "gtkx dev",
        "build": "gtkx build",
        "codegen": "gtkx codegen",
        "typecheck": "gtkx codegen && tsc",
        "start": "node dist/bundle.mjs",
        "deploy": "gtkx deploy",
        "build:flatpak": "gtkx deploy --target flatpak"
    },
    "dependencies": {
        "@gtkx/cairo": "^1.6.0",
        "@gtkx/components": "^1.6.0",
        "@gtkx/react": "^1.6.0",
        "@gtkx/runtime": "^1.6.0",
        "react": "^19.3.0"
    },
    "devDependencies": {
        "@gtkx/cli": "^1.6.0",
        "@gtkx/config": "^1.6.0",
        "@gtkx/testing": "^1.6.0",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "@swc/core": true
    }
}
